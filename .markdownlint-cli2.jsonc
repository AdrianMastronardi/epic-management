{
  "config": {
    "default": true,
    "line-length": false,
    "no-trailing-spaces": true,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-multiple-blanks": {
      "maximum": 1
    },
    "no-hard-tabs": true,
    "blanks-around-headings": {
      "lines_above": 1,
      "lines_below": 1
    },
    "blanks-around-lists": true,
    "list-marker-space": true,
    "ul-style": {
      "style": "dash"
    },
    "code-block-style": {
      "style": "fenced"
    },
    "fenced-code-language": true,
    "first-line-heading": true,
    "no-inline-html": false,
    // Graph and record tables are edited manually and grow one row at a time.
    // Requiring aligned pipes would turn each new row into a diff of the whole
    // table, for the same reason CONV-001 forbids hard line wrapping in prose.
    "table-column-style": false
  },
  "ignores": [
    "CLAUDE.md",
    "AGENTS.md"
  ]
}
